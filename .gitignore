# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Generated inner-fold annotations and source-pair rows (hashes/manifests retained)
/experiments/moment_detr_gmr_evidence_v5/inner_folds/**/*.jsonl
/experiments/moment_detr_gmr_evidence_v5/source_pairs/**/*.jsonl

# Data and feature storage (accessed via symlinks or external storage)
data/
features/
_external/

# Training runs, checkpoints, logs, and evaluation dumps
/results/*
!/results/dq_cgp_semantic_existence/
/results/dq_cgp_semantic_existence/*
!/results/dq_cgp_semantic_existence/A1/
!/results/dq_cgp_semantic_existence/C1/
outputs/
checkpoints/
*.ckpt
*.pt
*.pth
*.bin
*.npz
*.npy
*.tar
*.tar.gz
*.zip
*.log

# Sensitive credentials
*token*.txt
.env

# Editor & OS artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
.pytest_cache/
.ipynb_checkpoints/

# Published A1/C1 experiment logs, configuration, and metrics only
/results/dq_cgp_semantic_existence/**/*.jsonl
/results/dq_cgp_semantic_existence/**/tensorboard_log/
!/results/dq_cgp_semantic_existence/A1/**/*.log
!/results/dq_cgp_semantic_existence/C1/**/*.log

# Published Moment-DETR-TRM-GMR-Joint experiment metrics
!/results/moment_detr_trm_gmr_joint/
/results/moment_detr_trm_gmr_joint/queue/
/results/moment_detr_trm_gmr_joint/**/*.jsonl
